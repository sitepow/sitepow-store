  promptPayNumber String?

  isActive Boolean @default(true)

  referrals AffiliateReferral[]
  payouts   AffiliatePayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, customerId])
  @@unique([storeId, referralCode])
  @@index([storeId])
  @@index([customerId])
  @@index([referralCode])
}

model AffiliateReferral {
  id                 String           @id @default(uuid())
  orderId            String           @unique
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  affiliateAccountId String
  affiliateAccount   AffiliateAccount @relation(fields: [affiliateAccountId], references: [id], onDelete: Cascade)

  commissionAmount Decimal                   @db.Decimal(10, 2)
  commissionRate   Decimal                   @db.Decimal(5, 2)
  orderAmount      Decimal                   @db.Decimal(10, 2)
  status           AffiliateCommissionStatus @default(PENDING)

  approvedAt DateTime?
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateAccountId])
  @@index([status])
}

model AffiliatePayout {
  id                 String           @id @default(uuid())
  affiliateAccountId String
  affiliateAccount   AffiliateAccount @relation(fields: [affiliateAccountId], references: [id], onDelete: Cascade)

  amount Decimal      @db.Decimal(10, 2)
  status PayoutStatus @default(PENDING)

  bankName        String?
  bankAccountNo   String?
  bankAccountName String?
  promptPayNumber String?

  paymentProof String?
  note         String?
  paidAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateAccountId])
  @@index([status])
}

enum PartnerRole {
  SHAREHOLDER
  DEVELOPER
  SYSTEM
  MARKETING
  INVESTOR
  OTHER
}

enum ShareType {
  NET_PROFIT_PERCENT
  REVENUE_PERCENT
  FIXED_MONTHLY
}

model ProfitPartner {
  id              String         @id @default(uuid())
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  role            PartnerRole    @default(SHAREHOLDER)
  shareType       ShareType      @default(NET_PROFIT_PERCENT)
  shareValue      Decimal        @db.Decimal(10, 2)
  bankName        String?
  bankAccount     String?
  bankAccountName String?
  promptPay       String?
  note            String?        @db.Text
  isActive        Boolean        @default(true)
  payouts         ProfitPayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

model MonthlySettlement {
  id               String         @id @default(uuid())
  storeId          String
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  period           String
  periodLabel      String
  startDate        DateTime
  endDate          DateTime
  totalRevenue     Decimal        @default(0) @db.Decimal(12, 2)
  totalCogs        Decimal        @default(0) @db.Decimal(12, 2)
  totalExpense     Decimal        @default(0) @db.Decimal(12, 2)
  netProfit        Decimal        @default(0) @db.Decimal(12, 2)
  totalAllocated   Decimal        @default(0) @db.Decimal(12, 2)
  retainedEarnings Decimal        @default(0) @db.Decimal(12, 2)
  isClosed         Boolean        @default(false)
  payouts          ProfitPayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, period])
  @@index([storeId])
}

model ProfitPayout {
  id               String            @id @default(uuid())
  settlementId     String
  settlement       MonthlySettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  partnerId        String
  partner          ProfitPartner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerName      String
  role             PartnerRole
  shareType        ShareType
  shareValue       Decimal           @db.Decimal(10, 2)
  calculatedAmount Decimal           @db.Decimal(12, 2)
  status           PayoutStatus      @default(PENDING)
  paidAt           DateTime?
  slipImage        String?
  paymentNote      String?           @db.Text
  bankName         String?
  bankAccount      String?
  bankAccountName  String?
  promptPay        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([settlementId])
  @@index([partnerId])
}

enum SalaryType {
  MONTHLY
  DAILY
  HOURLY
  COMMISSION
}

model EmployeeSalaryConfig {
  id                String     @id @default(uuid())
  storeId           String
  store             Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  employeeId        String?
  employeeName      String
  employeeCode      String?
  department        String?
  position          String?
  salaryType        SalaryType @default(MONTHLY)
  baseSalary        Decimal    @default(0) @db.Decimal(10, 2)
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  promptpayNumber   String?
  socialSecurity    Boolean    @default(false)
  taxPercent        Decimal?   @default(0) @db.Decimal(5, 2)
  isActive          Boolean    @default(true)
  note              String?    @db.Text

  payrollItems MonthlyPayrollItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

model MonthlyPayroll {
  id              String    @id @default(uuid())
  storeId         String
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  period          String
  periodLabel     String
  startDate       DateTime
  endDate         DateTime
  totalBaseSalary Decimal   @default(0) @db.Decimal(12, 2)
  totalOvertime   Decimal   @default(0) @db.Decimal(12, 2)
  totalBonus      Decimal   @default(0) @db.Decimal(12, 2)
  totalCommission Decimal   @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal   @default(0) @db.Decimal(12, 2)
  totalNetSalary  Decimal   @default(0) @db.Decimal(12, 2)
  totalPaid       Decimal   @default(0) @db.Decimal(12, 2)
  isClosed        Boolean   @default(false)
  closedAt        DateTime?
  expenseId       String?
  expense         Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  note            String?   @db.Text

  items MonthlyPayrollItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, period])
  @@index([storeId])
  @@index([expenseId])
}

model MonthlyPayrollItem {
  id               String                @id @default(uuid())
  monthlyPayrollId String
  monthlyPayroll   MonthlyPayroll        @relation(fields: [monthlyPayrollId], references: [id], onDelete: Cascade)
  employeeConfigId String?
  employeeConfig   EmployeeSalaryConfig? @relation(fields: [employeeConfigId], references: [id], onDelete: SetNull)
  employeeName     String
  employeeCode     String?
  department       String?
  position         String?
  salaryType       SalaryType            @default(MONTHLY)
  baseSalary       Decimal               @default(0) @db.Decimal(10, 2)
  overtimeAmount   Decimal               @default(0) @db.Decimal(10, 2)
  bonusAmount      Decimal               @default(0) @db.Decimal(10, 2)
  commissionAmount Decimal               @default(0) @db.Decimal(10, 2)
  deductionAmount  Decimal               @default(0) @db.Decimal(10, 2)
  netSalary        Decimal               @default(0) @db.Decimal(10, 2)
  status           PayoutStatus          @default(PENDING)
  paidAt           DateTime?
  slipImage        String?
  paymentNote      String?               @db.Text
  bankName         String?
  bankAccount      String?
  bankAccountName  String?
  promptPay        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([monthlyPayrollId])
  @@index([employeeConfigId])
}
