  THB // Thai Baht
  USD // US Dollar
  EUR // Euro
  JPY // Japanese Yen
  GBP // British Pound Sterling
  AUD // Australian Dollar
  CAD // Canadian Dollar
  CHF // Swiss Franc
  CNY // Chinese Yuan
  HKD // Hong Kong Dollar
  SGD // Singapore Dollar
  KRW // South Korean Won
  TWD // New Taiwan Dollar
  INR // Indian Rupee
  IDR // Indonesian Rupiah
  MYR // Malaysian Ringgit
  PHP // Philippine Peso
  VND // Vietnamese Dong
  MMK // Myanmar Kyat
  KHR // Cambodian Riel
  LAK // Lao Kip
  BND // Brunei Dollar
  AED // United Arab Emirates Dirham
  SAR // Saudi Riyal
  NZD // New Zealand Dollar
}

enum ExpenseCategory {
  RENT // ค่าเช่าร้าน
  UTILITIES // ค่าน้ำ/ค่าไฟ/อินเทอร์เน็ต
  SALARY // ค่าจ้าง/เงินเดือนพนักงาน
  MARKETING // ค่าโฆษณา/การตลาด
  SUPPLIES // ค่าอุปกรณ์/ของใช้ในร้าน
  MAINTENANCE // ค่าซ่อมบำรุง
  TRANSPORT //ค่าเดินทาง/ขนส่ง
  OTHER // ค่าใช้จ่ายอื่นๆ
}

model Expense {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  title        String
  amount       Decimal         @db.Decimal(10, 2)
  category     ExpenseCategory @default(OTHER)
  receiptImage String?

  expenseDate DateTime @default(now())
  note        String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, expenseDate])
  @@index([branchId])
}

enum ThemeKey {
  DEFAULT // 1. ร้านค้าทั่วไป (General Retail / Supermarket)
  FOOD_BEVERAGE // 2. อาหาร/เครื่องดื่ม/คาเฟ่/วัตถุดิบ
  FASHION_LUXURY // 3. เสื้อผ้า/แฟชั่น/เครื่องประดับ/เครื่องสำอาง (เน้นภาพสวย)
  TECH_DIGITAL // 4. ไอที/สินค้าดิจิทัล/ซอฟต์แวร์/คีย์เกม (เน้น Spec & Instant)
  BOOKING_SERVICE // 5. บริการ/จองคิว/คอร์สเรียน/สปา/คลินิก (เน้นเวลา & นัดหมาย)
}

model StoreThemeConfig {
  id      String @id @default(uuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  themeKey ThemeKey @default(DEFAULT)

  layout Json?

  customCss Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
