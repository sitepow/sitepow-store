// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConversationType {
  SUPPORT
  STORE
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
  AI_ASSISTANT
}

model Conversation {
  id            String           @id @default(uuid())
  type          ConversationType
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastMessageAt DateTime         @default(now())

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  content        String       @db.Text
  type           MessageType  @default(TEXT)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Coupon {
  id          String  @id @default(cuid())
  code        String  @unique
  description String?

  discountType   DiscountType
  discountAmount Decimal      @db.Decimal(10, 2)

  minOrderAmount Decimal? @db.Decimal(10, 2)
  maxDiscount    Decimal? @db.Decimal(10, 2)

  startDate  DateTime
  endDate    DateTime
  usageLimit Int?
  usedCount  Int      @default(0)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order[]

  @@index([storeId])
  @@index([code])
}

enum CustomerType {
  INDIVIDUAL
  CORPORATION
}

model Customer {
  id        String    @id @default(cuid())
  email     String    @unique
  firstName String?
  lastName  String?
  phone     String?
  avatar    String?
  deletedAt DateTime?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerType CustomerType @default(INDIVIDUAL)

  stores         CustomerStore[]
  reviews        Review[]
  orders         Order[]
  cart           Cart?
  addresses      Address[]
  contactTickets ContactTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerStore {
  id         String   @id @default(cuid())
  customerId String
  storeId    String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  totalSpent   Decimal @default(0) @db.Decimal(10, 2)
  rewardPoints Int     @default(0)

  @@unique([customerId, storeId])
}

model Branch {
  id     String  @id @default(cuid())
  name   String
  isMain Boolean @default(false)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  province    String?
  district    String?
  subDistrict String?
  postcode    String?
  address     String? @db.Text

  staffs           StaffBranch[]
  orders           Order[]
  stocks           ProductStock[]
  coupons          Coupon[]
  transfersOut     StockTransfer[]   @relation("TransferFrom")
  transfersIn      StockTransfer[]   @relation("TransferTo")
  stockAdjustments StockAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  MERCHANT
  CUSTOMER
  SUPPORT
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model User {
  id                 String    @id @default(cuid())
  email              String?   @unique
  password           String?
  isTwoFactorEnabled Boolean   @default(false)
  name               String?
  image              String?
  otp                String?
  otpExpires         DateTime?
  isEmailVerified    Boolean?  @default(false)
  emailVerified      DateTime?
  role               UserRole  @default(CUSTOMER)
  phone              String?
  createdAt          DateTime  @default(now())

  orderNotify     Boolean @default(true)
  marketingNotify Boolean @default(false)

  staffProfile    Staff?
  customerProfile Customer?

  accounts      Account[]
  sessions      Session[]
  Authenticator Authenticator[]
  activityLogs  ActivityLog[]
}

model Staff {
  id    String @id @default(cuid())
  name  String
  email String @unique

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stores       StaffStore[]
  activityLogs ActivityLog[]
}

model StaffBranch {
  id           String     @id @default(cuid())
  staffStoreId String
  staffStore   StaffStore @relation(fields: [staffStoreId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([staffStoreId, branchId])
}

model StaffStore {
  id      String    @id @default(cuid())
  role    StaffRole @default(CASHIER)
  staffId String
  staff   Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  storeId String
  store   Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  branches StaffBranch[]

  @@unique([staffId, storeId])
}

enum StaffRole {
  ADMIN
  MANAGER
  CASHIER
}

enum StoreStatus {
  ACTIVE
  MAINTENANCE
  SUSPENDED
}

model Courier {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  services CourierService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model CourierService {
  id        String  @id @default(cuid())
  courierId String
  courier   Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  code          String  @unique
  name          String
  estimatedDays String?

  storeServices StoreCourierService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courierId])
  @@index([code])
}

enum ShippingZoneType {
  SAME_PROVINCE
  SAME_REGION
  CROSS_REGION
  REMOTE_AREA
}

model ShippingSetting {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  freeShipMin       Decimal @default(999.00) @db.Decimal(10, 2)
  isFreeShipEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreCourierService {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  courierServiceId String
  courierService   CourierService @relation(fields: [courierServiceId], references: [id], onDelete: Cascade)

  isEnabled Boolean @default(false)

  weightRates StoreServiceWeightRate[]
  zoneRates   StoreServiceZoneRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, courierServiceId])
  @@index([storeId])
  @@index([courierServiceId])
}

model StoreServiceWeightRate {
  id                    String              @id @default(cuid())
  storeCourierServiceId String
  storeCourierService   StoreCourierService @relation(fields: [storeCourierServiceId], references: [id], onDelete: Cascade)

  zoneType ShippingZoneType @default(SAME_PROVINCE)

  minWeight Decimal @default(0.00) @db.Decimal(10, 3)
  maxWeight Decimal @db.Decimal(10, 3)
  fee       Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeCourierServiceId])
}

model StoreServiceZoneRate {
  id                    String              @id @default(cuid())
  storeCourierServiceId String
  storeCourierService   StoreCourierService @relation(fields: [storeCourierServiceId], references: [id], onDelete: Cascade)

  zoneType      ShippingZoneType
  additionalFee Decimal          @default(0.00) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeCourierServiceId, zoneType])
  @@index([storeCourierServiceId])
}

model PaymentSetting {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  isBankTransferEnabled Boolean @default(true)
  isStripeEnabled       Boolean @default(false)

  stripeSecretKey String?
  stripePublicKey String?

  bankAccounts BankAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankAccount {
  id               String         @id @default(cuid())
  paymentSettingId String
  paymentSetting   PaymentSetting @relation(fields: [paymentSettingId], references: [id], onDelete: Cascade)

  bankName      String
  accountNumber String
  accountName   String
  qrImage       String?
  isDefault     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentSettingId])
}

model Store {
  id      String @id @default(cuid())
  name    String
  slug    String @unique
  ownerId String

  email       String?
  logo        String?
  coverImage  String?
  description String? @db.Text

  phone        String?
  lineId       String?
  facebookPage String?

  shippingSetting      ShippingSetting?
  storeCourierServices StoreCourierService[]

  taxId           String?
  isVatRegistered Boolean @default(false)
  vatRate         Decimal @default(7.0) @db.Decimal(10, 2)

  plan            Plan        @default(STARTER)
  status          StoreStatus @default(ACTIVE)
  balance         Decimal     @default(0) @db.Decimal(10, 2)
  aiVisionCredits Int         @default(0)
  aiSearchCredits Int         @default(0)

  platformPoints Int           @default(0)
  subscription   Subscription?
  usage          StoreUsage?

  isPointsEnabled  Boolean  @default(false)
  pointEarningRate Decimal? @db.Decimal(10, 2)
  pointRedeemRate  Decimal? @db.Decimal(10, 2)

  notifyLowStock     Boolean @default(true)
  notifyDailySummary Boolean @default(true)
  notifyBillingAlert Boolean @default(true)

  blogs                Blog[]
  categories           Category[]
  products             Product[]
  reviews              Review[]
  orders               Order[]
  customers            CustomerStore[]
  transactions         Transaction[]
  carts                Cart[]
  aiLogs               AiLog[]
  branches             Branch[]
  activityLogs         ActivityLog[]
  coupons              Coupon[]
  contactTickets       ContactTicket[]
  transferRequests     StoreTransferRequest[]
  stockTransfers       StockTransfer[]
  stockAdjustments     StockAdjustment[]
  PaymentSetting       PaymentSetting[]
  StaffStore           StaffStore[]
  subscriptionInvoices SubscriptionInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model StoreTransferRequest {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  fromOwnerId String
  toEmail     String
  toUserId    String?

  token     String         @unique @default(cuid())
  status    TransferStatus @default(PENDING)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([token])
}

enum InvoiceStatus {
  PAID
  UNPAID
  FAILED
}

model SubscriptionInvoice {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  plan        Plan
  amount      Decimal       @db.Decimal(10, 2)
  status      InvoiceStatus @default(UNPAID)
  paidAt      DateTime?
  periodStart DateTime
  periodEnd   DateTime
  description String?

  createdAt DateTime @default(now())

  @@index([storeId])
}

model Subscription {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  plan          Plan
  status        SubStatus @default(ACTIVE)
  startDate     DateTime  @default(now())
  endDate       DateTime
  pendingPlan   Plan?
  pendingPlanAt DateTime?

  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model StoreUsage {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  aiVisionUsed Int @default(0)
  aiSearchUsed Int @default(0)
  productCount Int @default(0)

  lastResetDate DateTime @default(now())
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum Plan {
  FREE
  STARTER
  PRO
  ULTIMATE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model ContactTicket {
  id      String       @id @default(cuid())
  subject String
  message String       @db.Text
  status  TicketStatus @default(OPEN)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([customerId])
}

model Blog {
  id      String   @id @default(cuid())
  title   String
  content String   @db.Text
  image   String
  slug    String   @unique
  tags    String[]

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String  @id @default(cuid())
  title       String
  slug        String
  description String?
  image       String?

  storeId  String
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

model Product {
  id    String @id @default(cuid())
  title String
  slug  String

  productType ProductType @default(PHYSICAL)
  digitalUrl  String?

  tags    ProductTag[]
  details Json?

  weight Float?
  width  Float?
  height Float?
  length Float?

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images   ProductImage[]
  variants ProductVariant[]
  options  ProductOption[]
  addons   ProductAddon[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([categoryId])
}

model ProductTag {
  id        String  @id @default(cuid())
  name      String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  isPrimary Boolean @default(false)

  variants ProductVariant[]

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id    String  @id @default(cuid())
  title String
  price Decimal @db.Decimal(10, 2)
  sku   String

  discountType   DiscountType?
  discountAmount Decimal?      @db.Decimal(10, 2)
  discountActive Boolean       @default(false)

  pointsAmount Int     @default(0)
  pointsActive Boolean @default(false)

  imageId String?
  image   ProductImage? @relation(fields: [imageId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  reviews          Review[]
  stocks           ProductStock[]
  stockTransfers   StockTransfer[]
  stockAdjustments StockAdjustment[]
}

model ProductOption {
  id        String  @id @default(cuid())
  title     String
  maxSelect Int     @default(1)
  require   Boolean @default(false)

  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  choices   ProductChoice[]
}

model ProductChoice {
  id         String  @id @default(cuid())
  name       String
  extraPrice Decimal @default(0) @db.Decimal(10, 2)

  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
}

model ProductAddon {
  id          String  @id @default(cuid())
  title       String
  price       Decimal @db.Decimal(10, 2)
  isAvailable Boolean @default(true)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id      String   @id @default(cuid())
  rating  Int
  comment String   @db.Text
  images  String[]
  video   String?
  date    DateTime @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  storeId   String
  store     Store          @relation(fields: [storeId], references: [id])
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  selectedOptions Json?
  categories      ReviewCategory[]
}

model ReviewCategory {
  id       String @id @default(cuid())
  label    String
  rating   Int
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  TRANSFER
  QR_PROMPTPAY
  CREDIT_CARD
  CASH_ON_DELIVERY
}

enum DeliveryStatus {
  PENDING
  BOOKED
  PICKING_UP
  IN_TRANSIT
  DELIVERED
  RETURNED
  FAILED
}

enum TransactionType {
  CREDIT_PURCHASE
  AI_USAGE
  SLIP_VERIFY
  REFUND
}

model Transaction {
  id          String          @id @default(cuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  amount      Decimal         @db.Decimal(10, 2)
  type        TransactionType
  description String?
  orderId     String?
  createdAt   DateTime        @default(now())

  @@index([storeId])
}

enum AddressType {
  SHIPPING
  TAX
  BOTH
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name         String
  taxName      String?
  phone        String
  receiverName String?

  addressLine String
  subDistrict String
  district    String
  province    String
  postalCode  String

  type       AddressType @default(SHIPPING)
  taxId      String?
  branchCode String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  totalAmount Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  isTaxInvoiceRequested Boolean @default(false)
  taxName               String?
  taxId                 String?
  taxAddress            String?
  taxBranchCode         String?

  usedPoints     Int?     @default(0)
  pointsDiscount Decimal? @default(0) @db.Decimal(10, 2)
  earnedPoints   Int?     @default(0)

  pointRedeemRateSnapshot  Decimal? @db.Decimal(10, 2)
  pointEarningRateSnapshot Decimal? @db.Decimal(10, 2)

  shippingMethod String?
  shippingFee    Decimal?       @db.Decimal(10, 2)
  trackingNumber String?
  shippopId      String?
  deliveryStatus DeliveryStatus @default(PENDING)

  paymentMethod PaymentMethod?
  paymentProof  String?
  paidAt        DateTime?
  transactionId String?

  totalWeight Float?
  width       Float?
  height      Float?
  length      Float?

  storeId    String
  store      Store     @relation(fields: [storeId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  guestEmail           String?
  guestPhone           String?
  guestName            String?
  shippingAddrSnapshot Json?
  storeSnapshot        Json?

  items          OrderItem[]
  contactTickets ContactTicket[]
  createdAt      DateTime        @default(now())

  @@index([storeId])
  @@index([customerId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId    String
  title        String
  variantId    String
  variantTitle String
  quantity     Int
  price        Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

model Cart {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId    String
  productTitle String
  image        String

  variantId String
  variant   Json

  selectedOptions Json?
  selectedAddons  Json?

  quantity     Int     @default(1)
  unitPrice    Decimal @db.Decimal(10, 2)
  totalPrice   Decimal @db.Decimal(10, 2)
  rewardPoints Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiLog {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  action  String
  prompt  String @db.Text
  cost    Int    @default(1)

  createdAt DateTime @default(now())
}

enum LogAction {
  CREATE_STORE
  UPDATE_STORE
  DELETE_STORE
  CHANGE_PLAN
  ADJUST_CREDITS
  SUSPEND_STORE
  CREATE_ORDER
  UPDATE_ORDER_STATUS
  CANCEL_ORDER
  RESTOCK_ITEMS
  UPDATE_STOCK
  STOCK_TRANSFER
  CREATE_PRODUCT
  DELETE_PRODUCT
  UPDATE_STORE_SETTING
  MANAGE_STAFF
  TRANSFER_STORE
  LOGIN
  LOGOUT
}

model ActivityLog {
  id     String    @id @default(cuid())
  action LogAction

  actorType ActorType

  userId  String?
  user    User?   @relation(fields: [userId], references: [id])
  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id])

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  entity   String
  entityId String?

  details Json?

  ipAddress String?
  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([action])
}

model StockAdjustment {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  quantity Int
  reason   StockAdjustmentReason
  note     String?

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([variantId])
  @@index([branchId])
}

enum StockAdjustmentReason {
  DAMAGED
  LOST
  EXPIRED
  CORRECTION
  PROMOTION
  OTHER
}

model GlobalShippingRateMatrix {
  id           String @id @default(cuid())
  fromProvince String @unique

  ratesMatrix Json

  updatedAt DateTime @updatedAt
}

model StockTransfer {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  fromBranchId String
  fromBranch   Branch @relation("TransferFrom", fields: [fromBranchId], references: [id])

  toBranchId String
  toBranch   Branch @relation("TransferTo", fields: [toBranchId], references: [id])

  quantity Int
  note     String?

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([variantId])
  @@index([fromBranchId])
  @@index([toBranchId])
}

model ProductStock {
  id       String @id @default(cuid())
  quantity Int    @default(0)
  minStock Int    @default(0)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([branchId, variantId])
  @@index([branchId])
  @@index([variantId])
}

enum ActorType {
  SYSTEM
  SUPER_ADMIN
  MERCHANT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}
