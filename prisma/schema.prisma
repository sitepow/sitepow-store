// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConversationType {
  SUPPORT
  STORE
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
  AI_ASSISTANT
}

model Conversation {
  id            String           @id @default(uuid())
  type          ConversationType
  storeId       String?
  store         Store?           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastMessageAt DateTime         @default(now())
  isAiEnabled   Boolean          @default(true)

  members  ConversationMember[]
  messages Message[]

  @@index([storeId])
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())
  unreadCount    Int          @default(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId  String
  content   String      @db.Text
  type      MessageType @default(TEXT)
  createdAt DateTime    @default(now())

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
}

model Coupon {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?

  discountType   DiscountType
  discountAmount Decimal      @db.Decimal(10, 2)

  minOrderAmount Decimal? @db.Decimal(10, 2)
  maxDiscount    Decimal? @db.Decimal(10, 2)

  startDate  DateTime
  endDate    DateTime
  usageLimit Int?
  usedCount  Int      @default(0)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order[]

  @@index([storeId])
  @@index([code])
}

model Customer {
  id        String    @id @default(uuid())
  email     String    @unique
  firstName String?
  lastName  String?
  phone     String?
  avatar    String?
  deletedAt DateTime?

  isBlocked     Boolean   @default(false)
  fakeSlipCount Int       @default(0)
  blockedUntil  DateTime?
  userId        String?   @unique
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  stores        CustomerStore[]
  reviews       Review[]
  orders        Order[]
  cart          Cart?
  addresses     Address[]
  slipHistories SlipVerificationHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SlipVerificationHistory {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  orderId  String
  imageUrl String
  isValid  Boolean
  message  String?

  checkedAt DateTime @default(now())

  @@index([customerId])
}

model CustomerStore {
  id         String   @id @default(uuid())
  customerId String
  storeId    String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  totalSpent   Decimal @default(0) @db.Decimal(10, 2)
  rewardPoints Int     @default(0)

  @@unique([customerId, storeId])
}

model Branch {
  id     String  @id @default(uuid())
  name   String
  isMain Boolean @default(false)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  address      String? @db.Text
  province     String?
  district     String?
  subDistrict  String?
  postcode     String?
  mapUrl       String? @db.Text
  openingHours Json?

  employeeBranches EmployeeBranch[]
  orderItem        OrderItem[]
  stocks           ProductStock[]
  coupons          Coupon[]
  transfersOut     StockTransfer[]   @relation("TransferFrom")
  transfersIn      StockTransfer[]   @relation("TransferTo")
  stockAdjustments StockAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  MERCHANT
  CUSTOMER
  SUPPORT
  BOT
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model User {
  id                 String    @id @default(uuid())
  email              String?   @unique
  password           String?
  isTwoFactorEnabled Boolean   @default(false)
  name               String?
  image              String?
  otp                String?
  otpExpires         DateTime?
  isEmailVerified    Boolean?  @default(false)
  emailVerified      DateTime?
  role               UserRole  @default(CUSTOMER)
  phone              String?
  createdAt          DateTime  @default(now())

  orderNotify     Boolean @default(true)
  marketingNotify Boolean @default(false)

  employee Employee?
  customer Customer?

  accounts           Account[]
  activityLogs       ActivityLog[]
  messages           Message[]
  ConversationMember ConversationMember[]
  ownedStores        Store[]              @relation("StoreOwner")
}

enum DefaultRole {
  OWNER
  MANAGER
  CASHIER
  STAFF
}

model Employee {
  id    String @id @default(uuid())
  name  String
  email String @unique

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stores       EmployeeStore[]
  activityLogs ActivityLog[]
  orders       Order[]
}

model EmployeePermission {
  employeeStoreId String
  employeeStore   EmployeeStore @relation(fields: [employeeStoreId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([employeeStoreId, permissionId])
}

model Role {
  id      String      @id @default(uuid())
  storeId String
  store   Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name    DefaultRole @default(OWNER)

  permissions    RolePermission[]
  employeeStores EmployeeStore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, name])
}

enum PermissionDomain {
  STORE
  CATEGORY
  PRODUCT
  ORDER
  INVENTORY
  CUSTOMER
  COUPON
  STAFF
  SETTING
  REPORT
  BRANCH
  BLOG
  SHIPPING
  PAYMENT
  SUBSCRIPTION
  TRANSACTION
  CONVERSATION
  FINANCE
  LOG
  STORE_PROFILE
  SECURITY
  NOTIFICATION
  STORE_TRANSFER
  TAX
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  EXPORT
  IMPORT
  APPROVE
  CANCEL
  VOID
}

model Permission {
  id        String           @id @default(uuid())
  domain    PermissionDomain
  action    PermissionAction
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  roles     RolePermission[]
  employees EmployeePermission[]

  @@unique([domain, action])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model EmployeeStore {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  branches    EmployeeBranch[]
  permissions EmployeePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, employeeId])
}

model EmployeeBranch {
  employeeStoreId String
  employeeStore   EmployeeStore @relation(fields: [employeeStoreId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([employeeStoreId, branchId])
}

enum StoreStatus {
  ACTIVE
  MAINTENANCE
  SUSPENDED
}

model Courier {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  services CourierService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model CourierService {
  id        String  @id @default(uuid())
  courierId String
  courier   Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  code          String  @unique
  name          String
  estimatedDays String?

  storeServices StoreCourierService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courierId])
  @@index([code])
}

enum ShippingZoneType {
  SAME_PROVINCE
  SAME_REGION
  CROSS_REGION
  REMOTE_AREA
}

model ShippingSetting {
  id      String @id @default(uuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  freeShipMin       Decimal @default(999.00) @db.Decimal(10, 2)
  isFreeShipEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreCourierService {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  courierServiceId String
  courierService   CourierService @relation(fields: [courierServiceId], references: [id], onDelete: Cascade)

  isEnabled    Boolean       @default(false)
  isCodEnabled Boolean       @default(false)
  codFeeType   DiscountType? @default(PERCENTAGE)
  codFeeAmount Decimal?      @default(2.3) @db.Decimal(10, 2)

  weightRates StoreServiceWeightRate[]
  zoneRates   StoreServiceZoneRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, courierServiceId])
  @@index([storeId])
  @@index([courierServiceId])
}

model StoreServiceWeightRate {
  id                    String              @id @default(uuid())
  storeCourierServiceId String
  storeCourierService   StoreCourierService @relation(fields: [storeCourierServiceId], references: [id], onDelete: Cascade)

  zoneType ShippingZoneType @default(SAME_PROVINCE)

  minWeight Decimal @default(0.00) @db.Decimal(10, 3)
  maxWeight Decimal @db.Decimal(10, 3)
  fee       Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeCourierServiceId])
}

model StoreServiceZoneRate {
  id                    String              @id @default(uuid())
  storeCourierServiceId String
  storeCourierService   StoreCourierService @relation(fields: [storeCourierServiceId], references: [id], onDelete: Cascade)

  zoneType      ShippingZoneType
  additionalFee Decimal          @default(0.00) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeCourierServiceId, zoneType])
  @@index([storeCourierServiceId])
}

model PaymentSetting {
  id      String @id @default(uuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  isBankTransferEnabled Boolean @default(true)
  isStripeEnabled       Boolean @default(false)

  stripeSecretKey     String?
  stripeWebhookSecret String?

  bankAccounts BankAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BankAccountType {
  PROMPTPAY
  STANDARD_TRANSFER
}

model BankAccount {
  id               String         @id @default(uuid())
  paymentSettingId String
  paymentSetting   PaymentSetting @relation(fields: [paymentSettingId], references: [id], onDelete: Cascade)

  bankName      String
  accountName   String
  accountNumber String

  type        BankAccountType @default(STANDARD_TRANSFER)
  order       Order[]
  promptPayId String?
  qrImage     String?
  isDefault   Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentSettingId])
}

enum DomainStatus {
  PENDING
  ACTIVE
  FAILED
}

model StoreDomain {
  id     String @id @default(uuid())
  domain String @unique

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  status DomainStatus @default(PENDING)

  verificationRecord Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

model Store {
  id      String @id @default(uuid())
  name    String
  slug    String @unique
  ownerId String
  owner   User   @relation("StoreOwner", fields: [ownerId], references: [id])

  email        String?
  logo         String?
  coverImage   String?
  primaryColor String? @default("#f97316")
  description  String? @db.Text

  phone        String?
  lineId       String?
  facebookPage String?

  productCount         Int                   @default(0)
  shippingSetting      ShippingSetting?
  storeCourierServices StoreCourierService[]

  taxId           String?
  isVatRegistered Boolean @default(false)
  vatRate         Decimal @default(7.0) @db.Decimal(10, 2)

  plan    Plan        @default(STARTER)
  status  StoreStatus @default(ACTIVE)
  balance Decimal     @default(0) @db.Decimal(10, 2)

  platformPoints Int           @default(0)
  subscription   Subscription?

  isPointsEnabled  Boolean  @default(true)
  pointEarningRate Decimal? @db.Decimal(10, 2)
  pointRedeemRate  Decimal? @default(0.35) @db.Decimal(10, 2)

  notifyLowStock     Boolean @default(true)
  notifyDailySummary Boolean @default(true)
  notifyBillingAlert Boolean @default(true)

  blogs                Blog[]
  categories           Category[]
  products             Product[]
  reviews              Review[]
  orders               Order[]
  customers            CustomerStore[]
  transactions         Transaction[]
  carts                Cart[]
  branches             Branch[]
  activityLogs         ActivityLog[]
  coupons              Coupon[]
  transferRequests     StoreTransferRequest[]
  stockTransfers       StockTransfer[]
  stockAdjustments     StockAdjustment[]
  PaymentSetting       PaymentSetting[]
  employeeStores       EmployeeStore[]
  subscriptionInvoices SubscriptionInvoice[]
  conversations        Conversation[]
  StoreDomain          StoreDomain[]
  role                 Role[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model StoreTransferRequest {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  fromOwnerId String
  toEmail     String
  toUserId    String?

  token     String         @unique @default(uuid())
  status    TransferStatus @default(PENDING)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([token])
}

enum InvoiceStatus {
  PAID
  UNPAID
  FAILED
  CANCELLED
}

model SubscriptionInvoice {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  plan        Plan
  amount      Decimal       @db.Decimal(10, 2)
  status      InvoiceStatus @default(UNPAID)
  paidAt      DateTime?
  periodStart DateTime
  periodEnd   DateTime
  description String?

  createdAt DateTime @default(now())

  @@index([storeId])
}

model Subscription {
  id      String @id @default(uuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  plan             Plan
  status           SubStatus @default(ACTIVE)
  startDate        DateTime  @default(now())
  endDate          DateTime
  pendingPlan      Plan?
  pendingPlanAt    DateTime?
  pendingPlanCycle String?

  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum Plan {
  FREE
  STARTER
  PRO
  ULTIMATE
}

model Blog {
  id      String   @id @default(uuid())
  title   String
  content String   @db.Text
  image   String
  slug    String   @unique
  tags    String[]

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String  @id @default(uuid())
  title       String
  slug        String
  description String?
  image       String?

  storeId  String
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
}

enum ProductType {
  PHYSICAL
  DIGITAL_LINK
  DIGITAL_ITEM
  DIGITAL_SERVICE
}

model Product {
  id    String @id @default(uuid())
  title String
  slug  String

  productType ProductType @default(PHYSICAL)

  tags    ProductTag[]
  details Json?

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images   ProductImage[]
  variants ProductVariant[]
  options  ProductOption[]
  addons   ProductAddon[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([categoryId])
}

model ProductTag {
  id        String  @id @default(uuid())
  name      String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
}

model ProductImage {
  id        String  @id @default(uuid())
  url       String
  isPrimary Boolean @default(false)

  variants ProductVariant[]

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model DigitalItem {
  id      String  @id @default(uuid())
  content String  @db.Text
  isUsed  Boolean @default(false)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
}

model ProductVariant {
  id          String  @id @default(uuid())
  title       String
  price       Decimal @db.Decimal(10, 2)
  sku         String
  digitalUrl  String? @db.Text
  isAvailable Boolean @default(true)

  discountType   DiscountType?
  discountAmount Decimal?      @db.Decimal(10, 2)
  discountActive Boolean       @default(false)

  weight Float?
  width  Float?
  height Float?
  length Float?

  pointsAmount Int     @default(0)
  pointsActive Boolean @default(false)

  imageId String?
  image   ProductImage? @relation(fields: [imageId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  reviews          Review[]
  stocks           ProductStock[]
  stockTransfers   StockTransfer[]
  stockAdjustments StockAdjustment[]
  digitalItems     DigitalItem[]
}

model ProductOption {
  id        String  @id @default(uuid())
  title     String
  maxSelect Int     @default(1)
  require   Boolean @default(false)

  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  choices   ProductChoice[]
}

model ProductChoice {
  id         String  @id @default(uuid())
  name       String
  extraPrice Decimal @default(0) @db.Decimal(10, 2)

  optionId String
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
}

model ProductAddon {
  id          String  @id @default(uuid())
  title       String
  price       Decimal @db.Decimal(10, 2)
  isAvailable Boolean @default(true)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id      String   @id @default(uuid())
  rating  Int
  comment String   @db.Text
  images  String[]
  video   String?
  date    DateTime @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  storeId   String
  store     Store          @relation(fields: [storeId], references: [id])
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  selectedOptions Json?
  categories      ReviewCategory[]
}

model ReviewCategory {
  id       String @id @default(uuid())
  label    String
  rating   Int
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  PENDING
  MANUAL_CHECK
  PAID
  SHIPPED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  MANUAL_QR_PROMPTPAY
  STRIPE_QR_PROMPTPAY
  STRIPE_CREDIT_CARD
  STRIPE_GOOGLE_PAY
  STRIPE_APPLE_PAY
  CASH_ON_DELIVERY
}

enum TransactionType {
  CREDIT_PURCHASE
  AI_USAGE
  SLIP_VERIFY
  REFUND
}

model Transaction {
  id          String          @id @default(uuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  amount      Decimal         @db.Decimal(10, 2)
  type        TransactionType
  description String?
  orderId     String?
  createdAt   DateTime        @default(now())

  @@index([storeId])
}

enum AddressType {
  SHIPPING
  TAX
  BOTH
}

model Address {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name         String
  taxName      String?
  phone        String
  receiverName String?

  addressLine String
  subDistrict String
  district    String
  province    String
  postalCode  String

  type       AddressType @default(SHIPPING)
  taxId      String?
  branchCode String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  totalAmount Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  isTaxInvoiceRequested Boolean @default(false)
  taxName               String?
  taxId                 String?
  taxAddress            String?
  taxBranchCode         String?

  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  usedPoints     Int?     @default(0)
  pointsDiscount Decimal? @default(0) @db.Decimal(10, 2)
  earnedPoints   Int?     @default(0)
  codFee         Decimal? @default(0) @db.Decimal(10, 2)

  pointRedeemRateSnapshot  Decimal? @db.Decimal(10, 2)
  pointEarningRateSnapshot Decimal? @db.Decimal(10, 2)

  shippingMethod String?
  shippingFee    Decimal? @db.Decimal(10, 2)
  trackingNumber String?

  paymentMethod PaymentMethod?
  paymentProof  String?
  paidAt        DateTime?
  transactionId String?

  totalWeight Float?
  width       Float?
  height      Float?
  length      Float?

  storeId    String
  store      Store     @relation(fields: [storeId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  shippingAddrSnapshot Json?
  storeSnapshot        Json?

  items       OrderItem[]
  digitalItem DigitalItem[]
  createdAt   DateTime      @default(now())

  @@index([storeId])
  @@index([customerId])
  @@index([bankAccountId])
  @@index([employeeId])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  productType  ProductType
  customerNote String?     @db.Text
  productId    String
  title        String
  variantId    String
  variantTitle String
  quantity     Int
  price        Decimal     @db.Decimal(10, 2)

  @@index([orderId])
}

model Cart {
  id         String   @id @default(uuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id     String @id @default(uuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId    String
  productTitle String
  image        String

  variantId String
  variant   Json

  selectedOptions Json?
  selectedAddons  Json?

  quantity     Int     @default(1)
  unitPrice    Decimal @db.Decimal(10, 2)
  totalPrice   Decimal @db.Decimal(10, 2)
  rewardPoints Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LogAction {
  CREATE_STORE
  UPDATE_STORE
  DELETE_STORE
  CHANGE_PLAN
  ADJUST_CREDITS
  SUSPEND_STORE
  CREATE_ORDER
  UPDATE_ORDER_STATUS
  CANCEL_ORDER
  RESTOCK_ITEMS
  UPDATE_STOCK
  STOCK_TRANSFER
  CREATE_PRODUCT
  DELETE_PRODUCT
  UPDATE_STORE_SETTING
  MANAGE_EMPLOYEE
  TRANSFER_STORE
  BLOCK_CUSTOMER
  UNBLOCK_CUSTOMER
  LOGIN
  LOGOUT
}

model ActivityLog {
  id     String    @id @default(uuid())
  action LogAction

  actorType ActorType

  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  entity   String
  entityId String?

  details Json?

  ipAddress String?
  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([action])
}

model StockAdjustment {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  quantity Int
  reason   StockAdjustmentReason
  note     String?

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([variantId])
  @@index([branchId])
}

enum StockAdjustmentReason {
  DAMAGED
  LOST
  EXPIRED
  CORRECTION
  PROMOTION
  OTHER
}

model GlobalShippingRateMatrix {
  id           String @id @default(uuid())
  fromProvince String @unique

  ratesMatrix Json

  updatedAt DateTime @updatedAt
}

model StockTransfer {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  fromBranchId String
  fromBranch   Branch @relation("TransferFrom", fields: [fromBranchId], references: [id])

  toBranchId String
  toBranch   Branch @relation("TransferTo", fields: [toBranchId], references: [id])

  quantity Int
  note     String?

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([variantId])
  @@index([fromBranchId])
  @@index([toBranchId])
}

model ProductStock {
  id       String @id @default(uuid())
  quantity Int    @default(0)
  minStock Int    @default(0)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([branchId, variantId])
  @@index([branchId])
  @@index([variantId])
}

enum ActorType {
  SYSTEM
  SUPER_ADMIN
  MERCHANT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}
