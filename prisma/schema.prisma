// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConversationType {
  SUPPORT
  STORE
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
  AI_ASSISTANT
}

model Conversation {
  id            String           @id @default(uuid())
  type          ConversationType
  storeId       String?
  store         Store?           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastMessageAt DateTime         @default(now())
  isAiEnabled   Boolean          @default(true)

  members  ConversationMember[]
  messages Message[]

  @@index([storeId])
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())
  unreadCount    Int          @default(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId  String
  content   String      @db.Text
  type      MessageType @default(TEXT)
  createdAt DateTime    @default(now())

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model CustomerCoupon {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  usedCount Int @default(0)

  assignedAt DateTime  @default(now())
  lastUsedAt DateTime?

  @@unique([customerId, couponId])
  @@index([customerId])
  @@index([couponId])
}

model Coupon {
  id          String  @id @default(uuid())
  code        String
  description String?

  discountType   DiscountType
  discountAmount Decimal      @db.Decimal(10, 2)

  minOrderAmount Decimal? @db.Decimal(10, 2)
  maxDiscount    Decimal? @db.Decimal(10, 2)

  startDate  DateTime
  endDate    DateTime
  usageLimit Int?
  usedCount  Int      @default(0)

  limitPerCustomer Int?

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order           Order[]
  customerCoupons CustomerCoupon[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([code])
}

model Customer {
  id        String    @id @default(uuid())
  email     String    @unique
  firstName String?
  lastName  String?
  phone     String?
  avatar    String?
  deletedAt DateTime?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  stores            CustomerStore[]
  reviews           Review[]
  orders            Order[]
  carts             Cart[]
  addresses         Address[]
  slipHistories     SlipVerificationHistory[]
  customerCoupon    CustomerCoupon[]
  affiliateAccounts AffiliateAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, deletedAt])
}

model SlipVerificationHistory {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  imageUrl String
  isValid  Boolean
  message  String?

  checkedAt DateTime @default(now())

  @@index([customerId])
  @@index([orderId])
  @@index([storeId])
}

model CustomerStore {
  id         String   @id @default(uuid())
  customerId String
  storeId    String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  totalSpent   Decimal @default(0) @db.Decimal(10, 2)
  rewardPoints Int     @default(0)

  isBlocked     Boolean   @default(false)
  blockedUntil  DateTime?
  fakeSlipCount Int       @default(0)

  merchantNote String?  @db.Text
  tags         String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, storeId])
  @@index([storeId, isBlocked])
}

model Branch {
  id     String  @id @default(uuid())
  name   String
  isMain Boolean @default(false)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  address      String? @db.Text
  province     String?
  district     String?
  subDistrict  String?
  postcode     String?
  mapUrl       String? @db.Text
  openingHours Json?

  employeeBranches EmployeeBranch[]
  orderItem        OrderItem[]
  stocks           ProductStock[]
  coupons          Coupon[]
  transfersOut     StockTransfer[]   @relation("TransferFrom")
  transfersIn      StockTransfer[]   @relation("TransferTo")
  stockAdjustments StockAdjustment[]

  expenses               Expense[]
  marketplaceConnections MarketplaceConnection[]
  tableZones             TableZone[]
  restaurantTables       RestaurantTable[]

  translations Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  MERCHANT
  CUSTOMER
  SUPPORT
  BOT
}

model Account {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId  String
  providerId String

  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?   @db.Text
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model User {
  id                 String    @id @default(uuid())
  email              String?   @unique
  password           String?
  isTwoFactorEnabled Boolean   @default(false)
  name               String?
  image              String?
  otp                String?
  otpExpires         DateTime?

  emailVerified Boolean  @default(false)
  role          UserRole @default(MERCHANT)
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  orderNotify     Boolean @default(true)
  marketingNotify Boolean @default(false)

  employee Employee?
  customer Customer?

  accounts           Account[]
  sessions           Session[]
  resellerAgreements ResellerAgreement[]

  activityLogs       ActivityLog[]
  messages           Message[]
  ConversationMember ConversationMember[]
  ownedStores        Store[]              @relation("StoreOwner")
}

enum DefaultRole {
  OWNER
  OWNER_VIEWER
  MANAGER
  CASHIER
  STAFF
  POS_RESELLER
  POS_CASHIER
  CONTENT_CREATOR
  AUDITOR
  SUPPORT
  MARKETING
  FULFILLMENT
}

model Employee {
  id    String @id @default(uuid())
  name  String
  email String @unique

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stores       EmployeeStore[]
  activityLogs ActivityLog[]
  orders       Order[]
}

model Role {
  id      String      @id @default(uuid())
  storeId String
  store   Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name    DefaultRole @default(OWNER)

  permissions      RolePermission[]
  employeeBranches EmployeeBranch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, name])
}

enum PermissionDomain {
  STORE
  CATEGORY
  PRODUCT
  ORDER
  INVENTORY
  CUSTOMER
  COUPON
  STAFF
  SETTING
  REPORT
  BRANCH
  BLOG
  SHIPPING
  PAYMENT
  SUBSCRIPTION
  TRANSACTION
  CONVERSATION
  FINANCE
  LOG
  STORE_PROFILE
  SECURITY
  NOTIFICATION
  STORE_TRANSFER
  TAX
  REVIEW
  EXPENSE
  RESELLER
  DOMAIN
  PAYROLL
  PROFIT_SHARING
  WEBHOOK
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  EXPORT
  IMPORT
  APPROVE
  CANCEL
  VOID
}

model Permission {
  id        String           @id @default(uuid())
  domain    PermissionDomain
  action    PermissionAction
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  roles                     RolePermission[]
  employeeBranchPermissions EmployeeBranchPermission[]

  @@unique([domain, action])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model EmployeeStore {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  branches EmployeeBranch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, employeeId])
}

model EmployeeBranchPermission {
  employeeBranchId String
  employeeBranch   EmployeeBranch @relation(fields: [employeeBranchId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([employeeBranchId, permissionId])
}

model EmployeeBranch {
  id              String        @id @default(uuid())
  employeeStoreId String
  employeeStore   EmployeeStore @relation(fields: [employeeStoreId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  customPermissions EmployeeBranchPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeStoreId, branchId])
}

enum StoreStatus {
  ACTIVE
  MAINTENANCE
  SUSPENDED
}

model Courier {
  id          String  @id @default(uuid())
  name        String
  description String?

  translations Json?

  services CourierService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourierService {
  id        String  @id @default(uuid())
  courierId String
  courier   Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  name          String
  estimatedDays String?

  translations Json?

  storeServices StoreCourierService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courierId])
}

enum ShippingZoneType {
  SAME_PROVINCE
  SAME_REGION
  CROSS_REGION
  REMOTE_AREA
  INTERNATIONAL
}

model ShippingSetting {
  id      String @id @default(uuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  freeShipMin       Decimal @default(999.00) @db.Decimal(10, 2)
  isFreeShipEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreCourierService {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  courierServiceId String
  courierService   CourierService @relation(fields: [courierServiceId], references: [id], onDelete: Cascade)

  isEnabled    Boolean       @default(false)
  isCodEnabled Boolean       @default(false)
  codFeeType   DiscountType? @default(PERCENTAGE)
  codFeeAmount Decimal?      @default(2.3) @db.Decimal(10, 2)

  advancedRules Json?

  weightRates StoreServiceWeightRate[]
  zoneRates   StoreServiceZoneRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, courierServiceId])
  @@index([storeId])
  @@index([courierServiceId])
}

model StoreServiceWeightRate {
  id                    String              @id @default(uuid())
  storeCourierServiceId String
  storeCourierService   StoreCourierService @relation(fields: [storeCourierServiceId], references: [id], onDelete: Cascade)

  zoneType ShippingZoneType @default(SAME_PROVINCE)

  minWeight Decimal @default(0.00) @db.Decimal(10, 3)
  maxWeight Decimal @db.Decimal(10, 3)
  fee       Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeCourierServiceId])
}

model StoreServiceZoneRate {
  id                    String              @id @default(uuid())
  storeCourierServiceId String
  storeCourierService   StoreCourierService @relation(fields: [storeCourierServiceId], references: [id], onDelete: Cascade)

  zoneType      ShippingZoneType
  additionalFee Decimal          @default(0.00) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeCourierServiceId, zoneType])
  @@index([storeCourierServiceId])
}

model ShippingZone {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name      String
  countries CountryCode[]

  rates ShippingZoneRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

model ShippingZoneRate {
  id             String       @id @default(uuid())
  shippingZoneId String
  shippingZone   ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)

  name          String
  estimatedDays String?
  minWeight     Decimal @default(0.00) @db.Decimal(10, 3)
  maxWeight     Decimal @db.Decimal(10, 3)
  fee           Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shippingZoneId])
}

model PaymentSetting {
  id      String @id @default(uuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  isBankTransferEnabled Boolean @default(true)
  isStripeEnabled       Boolean @default(false)

  stripeSecretKey     String?
  stripeWebhookSecret String?

  bankAccounts BankAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BankAccountType {
  PROMPTPAY
  STANDARD_TRANSFER
}

model BankAccount {
  id               String         @id @default(uuid())
  paymentSettingId String
  paymentSetting   PaymentSetting @relation(fields: [paymentSettingId], references: [id], onDelete: Cascade)

  bankName      String
  accountName   String
  accountNumber String

  type        BankAccountType @default(STANDARD_TRANSFER)
  order       Order[]
  promptPayId String?
  qrImage     String?
  isDefault   Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentSettingId])
}

enum DomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
}

enum SslStatus {
  PENDING
  ISSUED
  FAILED
}

model StoreDomain {
  id     String @id @default(uuid())
  domain String @unique

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  isPrimary Boolean @default(false)

  status    DomainStatus @default(PENDING)
  sslStatus SslStatus    @default(PENDING)

  verificationRecord Json?
  failureReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([domain, status])
}

enum CustomDomainStatus {
  PENDING
  ACTIVE
  FAILED
}

model Store {
  id      String @id @default(uuid())
  name    String
  slug    String @unique
  ownerId String
  owner   User   @relation("StoreOwner", fields: [ownerId], references: [id])

  email        String?
  logo         String?
  coverImage   String?
  primaryColor String? @default("#f97316")
  fontFamily   String? @default("default")
  description  String? @db.Text

  phone           String?
  lineId          String?
  facebookPage    String?
  instagramPage   String?
  tiktokPage      String?
  youtubePage     String?
  discordUrl      String?
  messengerUrl    String?
  socialLinks     Json?
  footerText      String? @db.Text
  footerCopyright String?

  productCount         Int                   @default(0)
  shippingSetting      ShippingSetting?
  storeCourierServices StoreCourierService[]
  shippingZones        ShippingZone[]

  taxId           String?
  isVatRegistered Boolean @default(false)
  vatRate         Decimal @default(7.0) @db.Decimal(10, 2)

  plan    Plan        @default(STARTER)
  status  StoreStatus @default(ACTIVE)
  balance Decimal     @default(0) @db.Decimal(10, 2)

  platformPoints Int           @default(0)
  subscription   Subscription?

  isPointsEnabled  Boolean  @default(true)
  pointEarningRate Decimal? @db.Decimal(10, 2)
  pointRedeemRate  Decimal? @default(0.35) @db.Decimal(10, 2)

  notifyLowStock     Boolean @default(true)
  notifyDailySummary Boolean @default(true)
  notifyBillingAlert Boolean @default(true)

  isInternationalSetup Boolean      @default(false)
  baseCurrency         CurrencyCode @default(THB)

  allowSearchEngineIndex Boolean @default(true)
  seoTitle               String?
  seoDescription         String? @db.Text
  seoKeywords            String?

  aboutPage         String? @db.Text
  faqsPage          String? @db.Text
  descriptionPage   String? @db.Text
  privacyPolicyPage String? @db.Text
  refundPolicyPage  String? @db.Text

  blogs                  Blog[]
  categories             Category[]
  products               Product[]
  reviews                Review[]
  orders                 Order[]
  customers              CustomerStore[]
  transactions           Transaction[]
  carts                  Cart[]
  branches               Branch[]
  activityLogs           ActivityLog[]
  coupons                Coupon[]
  transferRequests       StoreTransferRequest[]
  stockTransfers         StockTransfer[]
  stockAdjustments       StockAdjustment[]
  PaymentSetting         PaymentSetting[]
  employeeStores         EmployeeStore[]
  subscriptionInvoices   SubscriptionInvoice[]
  conversations          Conversation[]
  StoreDomain            StoreDomain[]
  role                   Role[]
  supplierAgreements     ResellerAgreement[]       @relation("SupplierAgreements")
  resellerAgreements     ResellerAgreement[]       @relation("ResellerAgreements")
  slipHistories          SlipVerificationHistory[]
  reviewRewardConfig     ReviewRewardConfig?
  expenses               Expense[]
  addresses              Address[]
  storeThemeConfig       StoreThemeConfig?
  webhookEndpoints       StoreWebhookEndpoint[]
  marketplaceConnections MarketplaceConnection[]
  marketplaceSyncLogs    MarketplaceSyncLog[]
  affiliateSetting       StoreAffiliateSetting?
  affiliateAccounts      AffiliateAccount[]
  profitPartners         ProfitPartner[]
  monthlySettlements     MonthlySettlement[]
  employeeSalaryConfigs  EmployeeSalaryConfig[]
  monthlyPayrolls        MonthlyPayroll[]
  tableZones             TableZone[]
  restaurantTables       RestaurantTable[]

  translations Json?

  customDomain       String?             @unique
  customDomainStatus CustomDomainStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model StoreTransferRequest {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  fromOwnerId String
  toEmail     String
  toUserId    String?

  token     String         @unique @default(uuid())
  status    TransferStatus @default(PENDING)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([token])
}

enum InvoiceStatus {
  PAID
  UNPAID
  FAILED
  CANCELLED
}

model SubscriptionInvoice {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  plan        Plan
  amount      Decimal       @db.Decimal(10, 2)
  status      InvoiceStatus @default(UNPAID)
  paidAt      DateTime?
  periodStart DateTime
  periodEnd   DateTime
  description String?

  createdAt DateTime @default(now())

  @@index([storeId])
}

model Subscription {
  id      String @id @default(uuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  plan             Plan
  status           SubStatus @default(ACTIVE)
  startDate        DateTime  @default(now())
  endDate          DateTime
  pendingPlan      Plan?
  pendingPlanAt    DateTime?
  pendingPlanCycle String?

  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum Plan {
  FREE
  STARTER
  PRO
  ULTIMATE
}

model Blog {
  id      String   @id @default(uuid())
  title   String
  content String   @db.Text
  image   String
  slug    String   @unique
  tags    String[]

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  translations Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String  @id @default(uuid())
  title       String
  slug        String
  description String?
  image       String?

  storeId  String
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  translations Json?

  @@unique([storeId, slug])
}

enum ProductType {
  PHYSICAL
  DIGITAL_LINK
  DIGITAL_ITEM
  DIGITAL_SERVICE
  AFFILIATE_LINK
}

model Product {
  id    String @id @default(uuid())
  title String
  slug  String

  productType ProductType @default(PHYSICAL)

  tags    ProductTag[]
  details Json?

  isPublished Boolean @default(true)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images   ProductImage[]
  variants ProductVariant[]
  options  ProductOption[]
  addons   ProductAddon[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations Json?

  @@unique([storeId, slug])
  @@index([categoryId])
  @@index([storeId, categoryId])
}

model ProductTag {
  id        String  @id @default(uuid())
  name      String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
}

model ProductImage {
  id        String  @id @default(uuid())
  url       String
  isPrimary Boolean @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model DigitalItem {
  id      String  @id @default(uuid())
  content String  @db.Text
  isUsed  Boolean @default(false)

  orderItemId String?
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
}

model ProductVariant {
  id          String   @id @default(uuid())
  title       String
  price       Decimal  @db.Decimal(10, 2)
  costPrice   Decimal? @default(0) @db.Decimal(10, 2)
  sku         String
  image       String?
  digitalUrl  String?  @db.Text
  isAvailable Boolean  @default(true)

  discountType   DiscountType?
  discountAmount Decimal?      @db.Decimal(10, 2)
  discountActive Boolean       @default(false)

  weight Float?
  width  Float?
  height Float?
  length Float?

  pointsAmount Int     @default(0)
  pointsActive Boolean @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  supplierVariantId String?

  translations Json?

  reviews             Review[]
  stocks              ProductStock[]
  stockTransfers      StockTransfer[]
